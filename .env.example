FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/momolib

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (Gmail SMTP)
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password

# Google Cloud Storage
GCS_BUCKET_NAME=momolib-files
GOOGLE_APPLICATION_CREDENTIALS=gcs-key.json

# MOMOAI 연동 (Phase 3)
MOMOAI_API_URL=https://momoai.kr
MOMOAI_API_KEY=

# APROLABS(momo_b2b_tablet) 연동 - 태블릿 교재(b2b_workbook)
# BASE_URL: 서버 간 통신용(같은 서버 내부, 예: http://127.0.0.1:8010)
# PUBLIC_BASE_URL: 학생 브라우저가 직접 여는 공개 주소(예: https://momolib.com/tablet) - 미설정 시 BASE_URL로 대체
APROLABS_BASE_URL=http://127.0.0.1:8010
APROLABS_PUBLIC_BASE_URL=
APROLABS_PARTNER_API_KEY=
APROLABS_NOTIFY_SECRET=
